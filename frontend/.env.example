# Public https address of the ReturnFlow API (no trailing slash). It is compiled into the bundle at build time.
# Local development: http://localhost:5000.   Vercel / production: https://api.your-domain.example (a production build
# fails if this is missing, http or localhost). This value is public: never put a secret in any VITE_ variable.
VITE_API_URL=http://localhost:5000
