# Address the browser uses for API calls (no trailing slash). It is compiled into the bundle at build time.
#
# Local development:                 http://localhost:5000
# Vercel, no custom domain:          the frontend's OWN address, for example https://return-flow-eight.vercel.app
#                                    (vercel.json forwards /api/* to the Render backend, so the browser stays on ONE origin
#                                    and the SameSite=Lax login cookie is accepted and sent)
# Custom domains (app. + api. under one registrable domain): https://api.your-domain.example
#
# A production build fails if this is missing, http or localhost. This value is public: never put a secret in any VITE_ variable.
VITE_API_URL=http://localhost:5000
