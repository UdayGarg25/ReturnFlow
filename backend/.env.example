PORT=5000

# development (default) | production. Production turns on Secure cookies, requires RESEND_*, hides the demo and dev routes.
# NODE_ENV=production
# --- PostgreSQL ---------------------------------------------------------------------------------------------------
# Production (Supabase, Render, any managed PostgreSQL): set DATABASE_URL and leave DB_* unset.
#   Supabase: use the Supavisor POOLER string (Project Settings > Database > Connection pooling, session mode, port 5432).
#   The "direct connection" host is IPv6-only and does not work from hosts without IPv6.
# DATABASE_URL=postgresql://user:password@host:5432/postgres
# TLS for DATABASE_URL: automatic for any non-local host. disable | require (encrypted, certificate not verified; fine for
# Supabase) | verify (also verifies the certificate; put the provider's CA PEM in DATABASE_SSL_CA).
# DATABASE_SSL=
# DATABASE_SSL_CA=
# DB_POOL_MAX=10                  keep (instances x this) below your database's connection limit
# DB_POOL_IDLE_MS=30000
# DB_POOL_CONNECT_TIMEOUT_MS=10000
# DB_STATEMENT_TIMEOUT_MS=        off unless set; some poolers reject it as a startup parameter
# Local development (used only when DATABASE_URL is not set):
DB_USER=postgres
DB_HOST=localhost
DB_NAME=returnflow
DB_PASSWORD=your-database-password
DB_PORT=5432

# Redis (optional in Phase 6). Leave blank to run without Redis.
REDIS_URL=
# Use rediss://user:password@host:port for a TLS-protected / authenticated provider. Redis is optional: without it the
# app runs on PostgreSQL alone (cache off, per-process rate limits, no distributed locks).
# The client reconnects forever with capped exponential backoff and jitter, so an outage heals without a restart.
# REDIS_COMMAND_TIMEOUT_MS=2000   a single Redis command gives up after this long (a request never waits on a stuck Redis)
# REDIS_SOCKET_TIMEOUT_MS=10000   idle-socket timeout; the client PINGs at half this, so only a dead connection trips it
# REDIS_MAX_BACKOFF_MS=30000      longest wait between reconnect attempts
# REDIS_STARTUP_WAIT_MS=3000      how long startup waits for Redis before the server starts without it
# Optional distributed lock settings (Phase 6 Step 4)
# REDIS_LOCK_DEFAULT_TTL_MS=10000
# REDIS_LOCK_ACQUIRE_TIMEOUT_MS=0
# Optional cache TTL (seconds) for public product catalog
# CATALOG_CACHE_TTL_SECONDS=60
# /health/ready: the public answer is only {"status":...}. The dependency detail (which service is down, Redis error code)
# is shown to an ADMIN session or to a monitor that sends the header  X-Health-Token: <this value>  (min. 16 characters;
# leave unset to switch token access off).
# HEALTH_CHECK_TOKEN=
# Optional graceful shutdown timeouts (milliseconds)
# SHUTDOWN_GRACE_MS=10000
# FORCE_SHUTDOWN_MS=15000

# Rate limiting limits (requests / failures per window)
# RATE_LIMIT_LOGIN_PER_IP=50
# RATE_LIMIT_LOGIN_FAILURES=5
# RATE_LIMIT_REGISTER_PER_IP=20
# RATE_LIMIT_AI_PER_USER=20
# RATE_LIMIT_INVITATION_PER_IP=60
# RATE_LIMIT_DEMO_PER_IP=200
# General /api limit: signed-in users are counted per USER (so offices behind one NAT do not share a budget),
# everyone else per IP.
# RATE_LIMIT_API_PER_USER=900
# RATE_LIMIT_API_PER_IP=300
# Password changes (POST /api/auth/change-password), per signed-in user. Demo accounts are always refused, whatever this is.
# RATE_LIMIT_CHANGE_PASSWORD_PER_USER=10
# Reverse proxy trust, which decides where req.ip comes from. false (default: no proxy), or the NUMBER of proxies in
# front of the app (Render, one Nginx or one load balancer = 1). Do not use "true": it trusts every X-Forwarded-For hop,
# so a client can forge its IP and dodge the IP limits. In production behind a proxy this MUST be set, or all users
# share the proxy's IP.
# TRUST_PROXY=false

# Authentication
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=1d

# Browser origins allowed to call the API with cookies (comma-separated).
# Defaults to http://localhost:5173 outside production; required in production.
CORS_ORIGIN=http://localhost:5173
# Optional: lax (default) | strict | none
# COOKIE_SAMESITE=lax

# Admin invitations - email through Resend (https://resend.com). Backend only: never put these in the frontend.
# Without RESEND_API_KEY (local development only) nothing is emailed: the invitation link is logged and
# shown to the admin instead. In production the key and sender are REQUIRED or the server will not start.
RESEND_API_KEY=
# Must be a sender your Resend account may use. "onboarding@resend.dev" works for testing but only delivers to
# the email address that owns the Resend account. For real recipients verify your own domain in Resend first.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=ReturnFlow
# Public URL of the web app, used for the link in the email (defaults to the first CORS_ORIGIN)
APP_BASE_URL=http://localhost:5173
# INVITATION_TTL_DAYS=7
# Demo admin created by: npm run db:seed-admin  (admin@returnflow.test / Password123!)
# ADMIN_EMAIL=  ADMIN_NAME=  ADMIN_PASSWORD=

# Public demo page (/demo): lets visitors continue as the four fixed demo accounts and run the guided
# return. On by default outside production; in production it stays OFF unless you set this to true.
# DEMO_ENABLED=true

# AWS S3 (private bucket; backend only, never expose to the frontend)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# OpenRouter AI-assisted warehouse inspection (backend only; never a VITE_ variable).
# Leave the key empty and everything else still works: the warehouse just inspects manually.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_PROVIDER=atlas-cloud/fp8

# Development-only: lets a warehouse user create an isolated TEST return with a photo they upload, to try the AI assessment
# for real in the warehouse UI (see README). Ignored in production. Off unless set to true.
# AI_TEST_SCENARIO=true

# --- Public demo (DEMO_ENABLED=true) ------------------------------------------------------------------------------
# DEMO_ENABLED=true makes the app a public demo whose Admin login is public on purpose. In that mode NO real email is ever
# sent: the admin invitation and resend endpoints still work and create their records, but the email service refuses to send
# (even if RESEND_* is set), and RESEND_API_KEY / RESEND_FROM_EMAIL are not needed to start in production.
# Leave DEMO_ENABLED unset (production) or false for a normal deployment: invitations are then really emailed.
# The public demo must use its OWN dedicated database (its own DATABASE_URL), never a development or personal one. The server
# logs "Database target: host:port/name" at startup (never credentials) so you can confirm it, and warns if demo mode in
# production is pointed at a database on the same machine.

# --- Database scripts (never run these in production by accident) --------------------------------------------------
# Fresh PRODUCTION database: npm run db:schema (safe to repeat), then npm run db:seed-admin with ADMIN_EMAIL and ADMIN_PASSWORD.
# On NODE_ENV=production or a DATABASE_URL, db:seed-admin REFUSES the public demo email (admin@returnflow.test or any
# @returnflow.test address), the public demo password, missing values and passwords under 12 characters.
# Fresh DEMO database: npm run db:schema, then npm run db:seed with CONFIRM_SEED_DEMO_DATA=yes (creates the public demo admin).
# db:seed, db:seed-demo and db:reset REFUSE to run when NODE_ENV=production or DATABASE_URL is set unless you explicitly set
# CONFIRM_SEED_DEMO_DATA=yes (demo databases only) or CONFIRM_DROP_ALL_TABLES=yes (erases everything). On ANY database, including
# a local one, db:reset and db:seed also refuse when it holds accounts that are not the seeded demo accounts, until you confirm.
